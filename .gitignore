# ==============================
# Renew / Java
# ==============================

*.class
*.jar
*.log

# Renew temporary / generated files
*.bak
*.tmp
*.autosave
*~
.~lock.*

# ==============================
# IDE
# ==============================

.idea/
*.iml

.vscode/
.settings/
.project
.classpath

# ==============================
# Operating System
# ==============================

.DS_Store
Thumbs.db
desktop.ini

# ==============================
# Build / Output
# ==============================

build/
out/
target/
bin/

# ==============================
# Simulation generated results
# ==============================

results/
simulation-output/
*.trace

# Keep the actual Renew models
!*.rnw

# Keep documentation
!README.md
!MODEL_VALIDATION.md

# Preserve formal experiment source data and evidence; generated classes stay ignored.
!results/
results/*
!results/*.csv
!results/*.json
!results/*.txt

# Dedicated post-P7 evidence; generated checkpoint/classes remain local.
!results/post_p7/
!results/post_p7/**/
!results/post_p7/**/*.csv
!results/post_p7/**/*.json
!results/post_p7/**/*.txt
!results/post_p7/**/*.md
results/post_p7/checkpoint/
results/post_p7/build/

# Python caches are disposable; the saved validation log is scientific evidence.
__pycache__/
*.pyc
!validation.log
